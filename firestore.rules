rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ─────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function coupleData(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)).data;
    }

    function coupleDataAfter(coupleId) {
      return getAfter(/databases/$(database)/documents/couples/$(coupleId)).data;
    }

    function roomData(code) {
      return get(/databases/$(database)/documents/rooms/$(code)).data;
    }

    function roomDataAfter(code) {
      return getAfter(/databases/$(database)/documents/rooms/$(code)).data;
    }

    function isCoupleMember(coupleId) {
      return isSignedIn() && request.auth.uid in coupleData(coupleId).memberUids;
    }

    // True when [uid] shares an active couple with the caller. Only the
    // caller's own profile is consulted, so a partner who has not claimed
    // the link on their own profile yet is still readable.
    function isMyPartner(uid) {
      let myCoupleId = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('coupleId', null);
      return myCoupleId is string
        && myCoupleId != ''
        && coupleData(myCoupleId).get('status', 'active') == 'active'
        && request.auth.uid in coupleData(myCoupleId).memberUids
        && uid in coupleData(myCoupleId).memberUids;
    }

    // True when an update leaves every one of [keys] untouched.
    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // True when an update touches nothing outside [keys].
    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // A room's creator withdraws a code nobody has used yet.
    function creatorCancelsRoom() {
      return resource.data.createdByUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && changesOnly(['status']);
    }

    // Another account joins a live code. The couple it links to must be
    // created in the same transaction, for exactly these two accounts.
    function partnerJoinsRoom() {
      return resource.data.status == 'pending'
        && request.time < resource.data.expiresAt
        && resource.data.createdByUid != request.auth.uid
        && request.resource.data.status == 'linked'
        && changesOnly(['status', 'coupleId'])
        && coupleDataAfter(request.resource.data.coupleId).memberUids
             == [resource.data.createdByUid, request.auth.uid];
    }

    // A couple may only be created by the join transaction: the joining
    // account plus the creator of the pending room being linked.
    function coupleCreatedByJoin(coupleId) {
      let members = request.resource.data.memberUids;
      let code = request.resource.data.pairingCode;
      return members is list
        && members.size() == 2
        && members[1] == request.auth.uid
        && roomData(code).status == 'pending'
        && roomData(code).createdByUid == members[0]
        && roomDataAfter(code).coupleId == coupleId;
    }

    // Ending the link, signed by whoever ends it.
    function isUnlinking() {
      return request.resource.data.status == 'unlinked'
        && request.resource.data.get('unlinkedByUid', null) == request.auth.uid;
    }

    // ── chests ──────────────────────────────────────────────────────────

    function capsuleData(coupleId, capsuleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)/capsules/$(capsuleId)).data;
    }

    function capsuleDataAfter(coupleId, capsuleId) {
      return getAfter(/databases/$(database)/documents/couples/$(coupleId)/capsules/$(capsuleId)).data;
    }

    // Opened, or a date chest whose date has come by the server's clock. The
    // phone's clock is never trusted.
    function isOpen(chest) {
      return chest.status == 'unlocked'
        || (chest.status == 'sealed'
            && chest.triggerMode == 'dateRelease'
            && request.time >= chest.unlockDate);
    }

    // A new chest starts sealed and untapped. Its date may already be past:
    // one sealed offline can reach the server after it was due.
    function isFreshlySealed() {
      let chest = request.resource.data;
      return chest.status == 'sealed'
        && chest.get('dualTapState', {}).size() == 0
        && (chest.triggerMode == 'dualTapSync'
            || (chest.triggerMode == 'dateRelease' && chest.unlockDate is timestamp));
    }

    function opensByDate() {
      return resource.data.status == 'sealed'
        && resource.data.triggerMode == 'dateRelease'
        && request.time >= resource.data.unlockDate
        && changesOnly(['status', 'openedAt'])
        && request.resource.data.status == 'unlocked';
    }

    // A partner records their own tap, and opens the chest only when both
    // taps are there. Player one is the couple's first member.
    function isTapping(coupleId) {
      let before = resource.data.get('dualTapState', {});
      let after = request.resource.data.get('dualTapState', {});
      let mine = coupleData(coupleId).memberUids[0] == request.auth.uid
        ? 'p1TappedAt' : 'p2TappedAt';
      return resource.data.status == 'sealed'
        && resource.data.triggerMode == 'dualTapSync'
        && changesOnly(['dualTapState', 'status', 'openedAt'])
        && after.diff(before).affectedKeys().hasOnly([mine])
        && after.get(mine, null) is timestamp
        && (unchanged(['status', 'openedAt'])
            || (request.resource.data.status == 'unlocked'
                && after.get('p1TappedAt', null) is timestamp
                && after.get('p2TappedAt', null) is timestamp));
    }

    function creatorCancelsChest() {
      return resource.data.creatorUid == request.auth.uid
        && resource.data.status == 'sealed'
        && request.resource.data.status == 'cancelled'
        && changesOnly(['status']);
    }

    function isArchiving() {
      return changesOnly(['isArchived']) && request.resource.data.isArchived is bool;
    }

    // Chests sealed by older builds hold their content in the chest itself.
    // Their creator may move it inside, in one step.
    function movesContentInside(coupleId, capsuleId) {
      return resource.data.creatorUid == request.auth.uid
        && resource.data.status == 'sealed'
        && changesOnly(['secretNote', 'photoUrl', 'voiceNoteUrl'])
        && !request.resource.data.keys().hasAny(['secretNote', 'photoUrl', 'voiceNoteUrl'])
        && existsAfter(/databases/$(database)/documents/couples/$(coupleId)/capsules/$(capsuleId)/sealed/content);
    }

    // ── users ───────────────────────────────────────────────────────────
    // Your own profile and your partner's. Profiles are only ever read by
    // id; listing them would expose every account's email and location.
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isMyPartner(uid));
      allow list: if false;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── rooms (pairing codes) ───────────────────────────────────────────
    // Fetching a room by its code is how a partner joins, so any account
    // may read one by id. Listing is limited to rooms you created (used to
    // recover a link made while you were signed out), so live codes can't
    // be harvested.
    match /rooms/{code} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.createdByUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn() && (creatorCancelsRoom() || partnerJoinsRoom());
    }

    // ── couples ─────────────────────────────────────────────────────────
    match /couples/{coupleId} {
      allow create: if isSignedIn() && coupleCreatedByJoin(coupleId);
      allow read: if isCoupleMember(coupleId);
      // Members change the quest, settings and unit, or unlink. Who the
      // members are never changes, and an unlinked couple is frozen: if it
      // could be set back to active, an ex-partner could regain access to
      // the other's profile and location.
      allow update: if isCoupleMember(coupleId)
        && resource.data.get('status', 'active') == 'active'
        && changesOnly(['reunionQuest', 'settings', 'unitPref', 'anniversaryDate',
             'status', 'unlinkedByUid', 'unlinkedAt'])
        && (unchanged(['status', 'unlinkedByUid', 'unlinkedAt']) || isUnlinking());

      match /memories/{memoryId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isCoupleMember(coupleId)
          && resource.data.authorUid == request.auth.uid
          && unchanged(['authorUid', 'createdAt']);
        allow delete: if isCoupleMember(coupleId)
          && resource.data.authorUid == request.auth.uid;

        match /comments/{commentId} {
          allow read: if isCoupleMember(coupleId);
          allow create: if isCoupleMember(coupleId)
            && request.resource.data.authorUid == request.auth.uid;
          allow update: if isCoupleMember(coupleId)
            && resource.data.authorUid == request.auth.uid
            && unchanged(['authorUid', 'createdAt']);
          allow delete: if isCoupleMember(coupleId)
            && resource.data.authorUid == request.auth.uid;
        }
      }

      // A chest: its title, how it opens, and whether it has. Both partners
      // see this; what is inside lives in sealed/content below.
      match /capsules/{capsuleId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.creatorUid == request.auth.uid
          && isFreshlySealed();
        allow update: if isCoupleMember(coupleId)
          && (opensByDate()
              || isTapping(coupleId)
              || creatorCancelsChest()
              || isArchiving()
              || movesContentInside(coupleId, capsuleId));
        allow delete: if isCoupleMember(coupleId)
          && resource.data.creatorUid == request.auth.uid;

        // What is sealed inside. The creator can always read it; the partner
        // only once the chest is open. It can't be changed after sealing.
        match /sealed/content {
          allow get: if isCoupleMember(coupleId)
            && (resource.data.creatorUid == request.auth.uid
                || isOpen(capsuleData(coupleId, capsuleId)));
          allow create: if isCoupleMember(coupleId)
            && request.resource.data.creatorUid == request.auth.uid
            && request.resource.data.keys().hasOnly(
                 ['creatorUid', 'secretNote', 'photoUrl', 'voiceNoteUrl'])
            && capsuleDataAfter(coupleId, capsuleId).creatorUid == request.auth.uid
            && capsuleDataAfter(coupleId, capsuleId).status == 'sealed';
        }
      }

      match /monthlyRecaps/{recapId} {
        allow read: if isCoupleMember(coupleId);
        allow write: if false;
      }
    }
  }
}
